{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "script-automator-bdbef",
          "appId": "1:873767716800:android:aeb684ad57a36a19882a25",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "script-automator-bdbef",
          "appId": "1:873767716800:ios:f34fa38821b8ed26882a25",
          "uploadDebugSymbols": true,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "script-automator-bdbef",
          "configurations": {
            "android": "1:873767716800:android:aeb684ad57a36a19882a25",
            "ios": "1:873767716800:ios:f34fa38821b8ed26882a25"
          }
        }
      }
    }
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ],
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "*.local",
      "scripts/**",
      "test/**",
      "src/**",
      "lib/**/*.test.js",
      ".env.*"
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
