rules_version = '2';
// Single source of truth for Storage rules (deployed from Script-Automator/).
service firebase.storage {
  match /b/{bucket}/o {

    // BOOTSTRAP: email fallback removed after the admin claim is confirmed.
    function isAdmin() {
      return request.auth != null
        && (request.auth.token.get('admin', false) == true || (request.auth.token.get('email', '') == 'chaunganpenny@gmail.com' && request.auth.token.get('email_verified', false) == true));
    }

    // Pending submissions: written by the author, read by the author and admins.
    match /submissions/{uid}/{fileName} {
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous'
                   && request.resource.size < 500 * 1024
                   && request.resource.contentType == 'text/javascript';
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Published gallery scripts: admin write, public read.
    match /gallery/{fileName} {
      allow read: if true;
      allow delete: if isAdmin();
      allow create, update: if isAdmin()
                   && request.resource.size < 1024 * 1024
                   && request.resource.contentType == 'text/javascript';
    }

    // User profile avatars.
    match /avatars/{uid}/{fileName} {
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 2 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }
  }
}
