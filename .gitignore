#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Native build
.cxx/
/android/.cxx/
/android/app/.cxx/

# Agent
.agent/rules

# Local secrets (see .env.example — prefer dart-define, not a committed .env)
.env

# Firebase Config
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart
# firebase.json is versioned: it holds rules/index/functions deploy config (app IDs are public).
# Local emulator snapshot (npm run demo)
emulator-data/

# Local run logs and stray Hive lock files
app_syslog.txt
syslog_output.txt
temp_run_log*.txt
scripts_content_v2_*.lock
# Firebase emulator / debug output
firebase-debug.log
firestore-debug.log
ui-debug.log
# Private signing secrets
**/android/key.properties
**/android/upload-keystore.jks

